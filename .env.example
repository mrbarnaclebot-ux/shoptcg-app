# Postgres connection. Leave unset locally to use the embedded PGlite file at .data/pglite.
DATABASE_URL=

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, used to build magic links.
BETTER_AUTH_URL=http://localhost:3000
# Deployed only: the custom domain (e.g. tcgmart.app). Every other host, such as the
# Railway one printed on old signs, redirects there. Must be BETTER_AUTH_URL's host.
CANONICAL_HOST=

# Resend. Leave unset in dev and magic links are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=shoptcg <onboarding@resend.dev>

# PokemonPriceTracker API key (Pro plan or higher). Leave unset and catalog search
# falls back to TCGdex, which needs no key.
PPT_API_KEY=

# Nightly price sync cap in PPT credits: 1 per item priced, 2 per history backfill.
# Only catalog items referenced by an active listing are priced.
SYNC_MAX_CALLS=5000
# History backfills per run, for items with under 3 days of prices.
SYNC_MAX_BACKFILL=200

# Web Push for seller request alerts. Generate once with:
#   pnpm dlx web-push generate-vapid-keys
# Leave unset and push is off (the open dashboard still chimes over SSE).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Pinata, for store banners and profile images. Both or neither. Leave unset
# locally and uploads are kept in the database row instead (dev and e2e only).
PINATA_JWT=
# Your dedicated gateway, e.g. your-name.mypinata.cloud
PINATA_GATEWAY_URL=

# Cloudflare Turnstile, the bot check when a buyer joins a claim event. Both or
# neither. Unset locally, joins skip the check; on Railway, joins are refused.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
